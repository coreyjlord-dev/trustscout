# Copy to .env. Leave the key blank to run the deterministic mock demo.
# Setting VULTR_INFERENCE_API_KEY switches model calls to Vultr Serverless Inference.
VULTR_INFERENCE_API_KEY=

# mock (default when the key is empty) or live.
TRUSTSCOUT_MODE=mock

# Optional local prompt-injection classifier. Not an LLM. 0 keeps it off.
# Model: protectai/deberta-v3-base-prompt-injection-v2
TRUSTSCOUT_LOCAL_GUARD=0

# Public URL the human browser uses. Slug buttons expand against this.
TRUSTSCOUT_PUBLIC_BASE=http://localhost:8080

# Where the sandbox proxy can reach this app.
# Compose sets http://web:8080. On a host process, use http://host.docker.internal:8080.
TRUSTSCOUT_INTERNAL_BASE=http://host.docker.internal:8080

# Docker network the proxy joins so it can reach the app. Empty uses the default bridge.
TRUSTSCOUT_APP_NETWORK=

# Same path on the host and in the control-plane container. See docker-compose.yml.
TRUSTSCOUT_DATA_DIR=./data
TRUSTSCOUT_HOST_DATA_DIR=

# docker (real sandboxes) or fake (unit tests only; not a security boundary).
TRUSTSCOUT_RUNNER=docker

# Force a Docker runtime. Empty prefers runsc (gVisor) and falls back to runc.
TRUSTSCOUT_RUNTIME=
